<Window x:Class="NotchIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchIsland"
        Width="580" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource GeistFont}"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8EF4F4F5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1FFFFFFF" />
                                <Setter Property="Foreground" Value="#5ee9ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Pill Style -->
        <Style x:Key="ActionPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionPillActiveStyle" TargetType="Button" BasedOn="{StaticResource ActionPillStyle}">
            <Setter Property="Background" Value="#5ee9ff" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ActionPillSmallStyle" TargetType="Button" BasedOn="{StaticResource ActionPillStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Bento Tile Style -->
        <Style x:Key="BentoTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <!-- Quick Toggle Style -->
        <Style x:Key="QuickToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#8EF4F4F5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="6,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#255ee9ff" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#5ee9ff" />
                                <Setter Property="Foreground" Value="#5ee9ff" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Mic Style -->
        <Style x:Key="HeroMicStyle" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="#0DFFFFFF" />
            <Setter Property="Foreground" Value="#8EF4F4F5" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterPillActiveStyle" TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
            <Setter Property="Background" Value="#2AFFFFFF" />
            <Setter Property="Foreground" Value="#5ee9ff" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Site Card Style -->
        <Style x:Key="SiteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Dashed Card Style -->
        <Style x:Key="DashedCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Clean ListBox Style -->
        <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#0DFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Margin="0,2" Padding="8,4">
                            <Grid>
                                <TextBlock Text="{Binding Text}" Foreground="#F4F4F5" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,50,0" />
                                <TextBlock Text="📋 Copy" Foreground="#5ee9ff" FontSize="10" HorizontalAlignment="Right" Cursor="Hand" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
        <!-- Animated Pet on top of notch -->
        <Border x:Name="PetBadge" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-16,0,0"
                Background="#000000" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10"
                Padding="8,2" Cursor="Hand" MouseLeftButtonDown="PetBadge_Click" Panel.ZIndex="10">
            <TextBlock x:Name="PetText" Text="(=^･ω･^=)" FontSize="11" Foreground="#5ee9ff" FontWeight="Medium" />
        </Border>

        <!-- Main Dynamic Island Squircle Container -->
        <Border x:Name="IslandBody" Width="230" Height="38" CornerRadius="19"
                Background="#000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                MouseEnter="IslandBody_MouseEnter" MouseLeave="IslandBody_MouseLeave"
                MouseLeftButtonDown="IslandBody_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.65" ShadowDepth="4" />
            </Border.Effect>

            <Grid Margin="12,4,12,4">
                <!-- COMPACT PILL VIEW -->
                <Grid x:Name="CompactView" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Time / Weather -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PillTime" Text="15:45" Foreground="#F4F4F5" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text=" · 22°C ☀️" Foreground="#8EF4F4F5" FontSize="11" Margin="4,0,0,0" />
                    </StackPanel>

                    <!-- Center: Music or Status -->
                    <TextBlock x:Name="PillTitle" Grid.Column="1" Text="Starboy · The Weeknd"
                               Foreground="#5ee9ff" FontSize="11" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,8,0" />

                    <!-- Right: Visualizer & Privacy Dots -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <!-- 3-bar animated visualizer -->
                        <Border x:Name="Bar1" Width="3" Height="10" Background="#5ee9ff" CornerRadius="1.5" Margin="1,0" />
                        <Border x:Name="Bar2" Width="3" Height="16" Background="#5ee9ff" CornerRadius="1.5" Margin="1,0" />
                        <Border x:Name="Bar3" Width="3" Height="8" Background="#5ee9ff" CornerRadius="1.5" Margin="1,0" />

                        <!-- Camera/Mic dots -->
                        <Ellipse Width="6" Height="6" Fill="#4be08a" Margin="4,0,0,0" ToolTip="Camera Ready" />
                    </StackPanel>
                </Grid>

                <!-- EXPANDED VIEW WITH 10 TABS -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 10-Tab Navigation Bar & Right Actions -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left 10 Tabs matching NotchPixel -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="TabMusic" Content="🎵" ToolTip="Music" Click="Tab_Click" Tag="Music" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabWeb" Content="🌐" ToolTip="Websites" Click="Tab_Click" Tag="Websites" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabNotif" Content="🔔" ToolTip="Notifications" Click="Tab_Click" Tag="Notifications" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabShelf" Content="📁" ToolTip="File Shelf" Click="Tab_Click" Tag="Shelf" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabClip" Content="📋" ToolTip="Clipboard" Click="Tab_Click" Tag="Clipboard" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabWidgets" Content="⊞" ToolTip="Widgets" Click="Tab_Click" Tag="Widgets" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabControls" Content="🎛️" ToolTip="Controls" Click="Tab_Click" Tag="Controls" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabTools" Content="⠿" ToolTip="Tools" Click="Tab_Click" Tag="Tools" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabDeck" Content="📱" ToolTip="PC Deck" Click="Tab_Click" Tag="Deck" Style="{StaticResource TabButtonStyle}" />
                            <Button x:Name="TabCalls" Content="🎧" ToolTip="Calls" Click="Tab_Click" Tag="Calls" Style="{StaticResource TabButtonStyle}" />
                        </StackPanel>

                        <!-- Right Dock: Theme & Settings -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🎨" ToolTip="Theme Surface" Click="ThemeBtn_Click" Style="{StaticResource TabButtonStyle}" />
                            <Button Content="⚙️" ToolTip="Settings" Click="SettingsBtn_Click" Style="{StaticResource TabButtonStyle}" />
                            <Button Content="▲" ToolTip="Collapse" Click="CollapseBtn_Click" Style="{StaticResource TabButtonStyle}" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- TAB CONTENT PANELS -->
                    <Grid Grid.Row="1" Margin="2,4,2,2">
                        <!-- TAB 1: MUSIC -->
                        <Grid x:Name="ContentMusic" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Vinyl Album Art -->
                            <Border Grid.Column="0" Width="60" Height="60" CornerRadius="12" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <TextBlock Text="💿" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="TrackTitle" Text="Starboy" FontSize="15" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                <TextBlock x:Name="TrackArtist" Text="The Weeknd, Daft Punk" FontSize="12" Foreground="#8EF4F4F5" Margin="0,1,0,6" />

                                <!-- Scrubber -->
                                <Slider x:Name="MusicSeek" Minimum="0" Maximum="100" Value="28" ValueChanged="MusicSeek_ValueChanged" />
                                <Grid Margin="0,2,0,6">
                                    <TextBlock x:Name="TimeElapsed" Text="1:06" FontSize="10" Foreground="#8EF4F4F5" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="TimeRemaining" Text="-2:44" FontSize="10" Foreground="#8EF4F4F5" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Controls & Volume -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="⏮" Click="MusicPrev_Click" Style="{StaticResource ActionBtnStyle}" />
                                        <Button x:Name="BtnPlayPause" Content="⏸" Click="MusicPlayPause_Click" Style="{StaticResource ActionBtnStyle}" Margin="8,0" />
                                        <Button Content="⏭" Click="MusicNext_Click" Style="{StaticResource ActionBtnStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="🔊" Foreground="#8EF4F4F5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="64" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 2: WEBSITES -->
                        <StackPanel x:Name="ContentWebsites" Visibility="Collapsed">
                            <TextBlock Text="Add a site: any page, signed in, one click away." FontSize="11" Foreground="#8EF4F4F5" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Border Style="{StaticResource SiteCardStyle}" MouseLeftButtonDown="LaunchSite_Click" Tag="https://music.youtube.com">
                                    <TextBlock Text="🎵 YouTube Music" Foreground="#F4F4F5" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource SiteCardStyle}" MouseLeftButtonDown="LaunchSite_Click" Tag="https://youtube.com">
                                    <TextBlock Text="▶️ YouTube" Foreground="#F4F4F5" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource SiteCardStyle}" MouseLeftButtonDown="LaunchSite_Click" Tag="https://spotify.com">
                                    <TextBlock Text="🎧 Spotify" Foreground="#F4F4F5" FontSize="12" />
                                </Border>
                                <Border Style="{StaticResource DashedCardStyle}" MouseLeftButtonDown="AddSite_Click">
                                    <TextBlock Text="+ Add a site" Foreground="#5ee9ff" FontSize="12" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- TAB 3: NOTIFICATIONS -->
                        <Grid x:Name="ContentNotifications" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🔔" FontSize="32" HorizontalAlignment="Center" Foreground="#8EF4F4F5" Margin="0,0,0,8" />
                                <TextBlock Text="Nothing yet" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" />
                                <TextBlock Text="What the island says lands here. Click one to open it." FontSize="11" Foreground="#8EF4F4F5" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- TAB 4: SHELF -->
                        <Grid x:Name="ContentShelf" Visibility="Collapsed">
                            <Border BorderBrush="#2AFFFFFF" BorderThickness="1.5" CornerRadius="12" Background="#08FFFFFF" Padding="14">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="📁 Drop files here" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" />
                                    <TextBlock Text="They wait here until you need them" FontSize="11" Foreground="#8EF4F4F5" HorizontalAlignment="Center" Margin="0,4,0,10" />
                                    <Button Content="📱 Send to phone" Click="SendToPhone_Click" Style="{StaticResource ActionPillStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TAB 5: CLIPBOARD -->
                        <Grid x:Name="ContentClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="All" Style="{StaticResource FilterPillActiveStyle}" />
                                <Button Content="Images" Style="{StaticResource FilterPillStyle}" Margin="6,0,0,0" />
                                <Button Content="Snippets" Style="{StaticResource FilterPillStyle}" Margin="6,0,0,0" />
                                <Button Content="Clear" Style="{StaticResource FilterPillStyle}" Margin="6,0,0,0" />
                            </StackPanel>
                            <ListBox x:Name="ClipboardList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding ClipboardItems}" Style="{StaticResource CleanListBoxStyle}" />
                        </Grid>

                        <!-- TAB 6: WIDGETS (4-BENTO GRID) -->
                        <Grid x:Name="ContentWidgets" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Date Tile -->
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource BentoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="📅 Saturday, Nov 14" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    <TextBlock Text="Su  Mo  Tu  We  Th  Fr  Sa" FontSize="10" Foreground="#8EF4F4F5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Pomodoro Focus Timer -->
                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource BentoTileStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" FontSize="20" Margin="0,0,8,0" />
                                    <StackPanel>
                                        <TextBlock x:Name="TimerText" Text="25:00" FontSize="15" FontWeight="Bold" Foreground="#5ee9ff" />
                                        <TextBlock Text="25+5 min Focus" FontSize="10" Foreground="#8EF4F4F5" />
                                    </StackPanel>
                                    <Button Content="▶" Click="TimerPlay_Click" Style="{StaticResource ActionBtnStyle}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Weather Tile -->
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BentoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="☀️ 22°C Clear Sky" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" />
                                    <TextBlock Text="Humidity 45% · Wind 8 km/h" FontSize="10" Foreground="#8EF4F4F5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Telemetry Tile -->
                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BentoTileStyle}">
                                <StackPanel>
                                    <TextBlock x:Name="TelemetryText" Text="⚡ 144 FPS · CPU 14% · RAM 7.6G" FontSize="11" FontWeight="SemiBold" Foreground="#5ee9ff" />
                                    <TextBlock Text="↓ 12.4 MB/s · ↑ 3.8 MB/s" FontSize="10" Foreground="#8EF4F4F5" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- TAB 7: CONTROLS -->
                        <Grid x:Name="ContentControls" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sliders -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="☀️ Brightness 100%" FontSize="11" Foreground="#8EF4F4F5" />
                                <Slider Value="100" Maximum="100" Margin="0,2,0,10" />
                                <TextBlock Text="🔊 Volume 64%" FontSize="11" Foreground="#8EF4F4F5" />
                                <Slider Value="64" Maximum="100" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Quick Toggles -->
                            <UniformGrid Grid.Column="1" Columns="3" Rows="2">
                                <ToggleButton Content="📶 Wi-Fi" IsChecked="True" Style="{StaticResource QuickToggleStyle}" />
                                <ToggleButton Content="ᛒ Bluetooth" IsChecked="True" Style="{StaticResource QuickToggleStyle}" />
                                <ToggleButton Content="🌙 Night light" Style="{StaticResource QuickToggleStyle}" />
                                <ToggleButton Content="🎯 Focus" Style="{StaticResource QuickToggleStyle}" />
                                <ToggleButton Content="🔇 Mute" Style="{StaticResource QuickToggleStyle}" />
                                <ToggleButton Content="🔋 Battery 100%" IsChecked="True" Style="{StaticResource QuickToggleStyle}" />
                            </UniformGrid>
                        </Grid>

                        <!-- TAB 8: TOOLS -->
                        <StackPanel x:Name="ContentTools" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="📸 Screenshot" Click="ToolScreenshot_Click" Style="{StaticResource ActionPillStyle}" />
                                <Button Content="✂️ Snip" Click="ToolSnip_Click" Style="{StaticResource ActionPillStyle}" Margin="8,0" />
                                <Button Content="🎥 Record" Style="{StaticResource ActionPillStyle}" />
                            </StackPanel>
                            <WrapPanel>
                                <Border Style="{StaticResource DashedCardStyle}"><TextBlock Text="+ Add Tool" Foreground="#5ee9ff" FontSize="11" /></Border>
                                <Border Style="{StaticResource DashedCardStyle}"><TextBlock Text="+ Add Tool" Foreground="#5ee9ff" FontSize="11" /></Border>
                                <Border Style="{StaticResource DashedCardStyle}"><TextBlock Text="+ Add Tool" Foreground="#5ee9ff" FontSize="11" /></Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- TAB 9: DECK -->
                        <Grid x:Name="ContentDeck" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📱 Your phone, as a deck for this PC" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" HorizontalAlignment="Center" />
                                <TextBlock Text="Web controller active on http://localhost:8088" FontSize="11" Foreground="#5ee9ff" HorizontalAlignment="Center" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="🟢 Turn on" Style="{StaticResource ActionPillActiveStyle}" />
                                    <Button Content="Get the app" Style="{StaticResource ActionPillStyle}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- TAB 10: CALLS -->
                        <Grid x:Name="ContentCalls" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hero Mic Toggle -->
                            <Button Grid.Column="0" Style="{StaticResource HeroMicStyle}" Click="MicToggle_Click">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🎤" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="Mic on" FontWeight="Bold" Foreground="#4be08a" HorizontalAlignment="Center" />
                                    <TextBlock Text="Click to mute" FontSize="10" Foreground="#8EF4F4F5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Speakers: Realtek High Definition Audio" FontSize="11" Foreground="#F4F4F5" />
                                <Button Content="🔊 Test sound" Style="{StaticResource ActionPillSmallStyle}" HorizontalAlignment="Left" Margin="0,2,0,8" />
                                <TextBlock Text="Microphone: Microphone Array" FontSize="11" Foreground="#F4F4F5" />
                                <Button Content="📷 Check camera" Style="{StaticResource ActionPillSmallStyle}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>