<Window x:Class="NotchIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchIsland"
        Width="600" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Authentic OLED Design System Brushes -->
        <SolidColorBrush x:Key="OledBlack" Color="#000000" />
        <SolidColorBrush x:Key="SurfaceDark" Color="#0B0B0C" />
        <SolidColorBrush x:Key="GlassFill" Color="#0EFFFFFF" />
        <SolidColorBrush x:Key="GlassHover" Color="#1EFFFFFF" />
        <SolidColorBrush x:Key="HairlineBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#EFEDE8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#99EFEDE8" />
        <SolidColorBrush x:Key="TextMuted" Color="#59EFEDE8" />
        <SolidColorBrush x:Key="AccentCyan" Color="#64D2FF" />
        <SolidColorBrush x:Key="StatusGreen" Color="#34C759" />
        <SolidColorBrush x:Key="StatusRed" Color="#FF453A" />
        <SolidColorBrush x:Key="StatusOrange" Color="#FF9F0A" />

        <!-- Tab Navigation Button Style -->
        <Style x:Key="TabNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource GlassHover}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Action Button Style -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBorder}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,4.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource GlassHover}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Launch Tile Style -->
        <Style x:Key="WebTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBorder}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Width" Value="88" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource GlassHover}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- ================= UNIFIED MORPHING ISLAND CONTAINER ================= -->
        <!-- Starts as exact Compact Pill: 212 x 38 px (r = 19 px). Morphs to Expanded: 540 x 270 px (r = 24 px) -->
        <Border x:Name="IslandContainer"
                Width="212" Height="38"
                Background="{StaticResource OledBlack}"
                BorderBrush="{StaticResource HairlineBorder}"
                BorderThickness="1"
                CornerRadius="19"
                Margin="0,6,0,0"
                ClipToBounds="True"
                Cursor="Hand"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown">

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="3" Opacity="0.80" />
            </Border.Effect>

            <Grid>
                <!-- ================= COMPACT PILL CONTENT ================= -->
                <Grid x:Name="PillContent" Margin="12,0" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Desktop Pet + Mini Visualizer -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PillPet" Text="(=^･ω･^=)" Foreground="{StaticResource AccentCyan}" FontSize="11" FontWeight="Bold" Margin="0,0,7,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="2.2" Height="9" Fill="{StaticResource AccentCyan}" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar2" Width="2.2" Height="13" Fill="{StaticResource StatusGreen}" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar3" Width="2.2" Height="7" Fill="{StaticResource AccentCyan}" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar4" Width="2.2" Height="15" Fill="{StaticResource StatusGreen}" Margin="1,0" RadiusX="1" RadiusY="1" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Track Info or Clock -->
                    <TextBlock x:Name="PillTitle"
                               Grid.Column="1"
                               Text="NotchIsland • 14:32"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="6,0" />

                    <!-- Right: Battery & Status Dot -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PillBattery" Text="98% ⚡" Foreground="{StaticResource StatusGreen}" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                        <Ellipse Width="5.5" Height="5.5" Fill="{StaticResource StatusGreen}" />
                    </StackPanel>
                </Grid>

                <!-- ================= EXPANDED CARD CONTENT ================= -->
                <Grid x:Name="CardContent" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top 13-Tab Navigation Bar in Authentic NotchPixel Order -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="0,0,0,1" Padding="6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- All 13 Tabs: Media, Web, Notifications, Chat, Agents, Shelf, Clipboard, Widgets, Controls, Tools, Deck, Tiles, Call -->
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎵" ToolTip="Media &amp; Music" Click="Tab_Click" Tag="Music" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🌐" ToolTip="Web Sites" Click="Tab_Click" Tag="Web" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🔔" ToolTip="Notifications" Click="Tab_Click" Tag="Notifications" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="💬" ToolTip="Chat" Click="Tab_Click" Tag="Chat" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🤖" ToolTip="AI Agents" Click="Tab_Click" Tag="Agents" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📁" ToolTip="File Shelf" Click="Tab_Click" Tag="Shelf" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📋" ToolTip="Clipboard" Click="Tab_Click" Tag="Clipboard" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="⊞" ToolTip="Widgets" Click="Tab_Click" Tag="Widgets" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎚" ToolTip="Controls" Click="Tab_Click" Tag="Controls" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="⠿" ToolTip="Tools" Click="Tab_Click" Tag="Tools" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📱" ToolTip="Phone Deck" Click="Tab_Click" Tag="Deck" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🔲" ToolTip="Quick Tiles" Click="Tab_Click" Tag="Tiles" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎧" ToolTip="Calls &amp; Audio" Click="Tab_Click" Tag="Calls" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Settings & Collapse Icons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TabNavButtonStyle}" Content="⚙" ToolTip="Settings" Click="SettingsBtn_Click" />
                                <Button Style="{StaticResource TabNavButtonStyle}" Content="▲" ToolTip="Collapse to Pill" Click="CollapseBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Dynamic Panels Area -->
                    <Grid Grid.Row="1" Margin="14,10">

                        <!-- 1. MUSIC / MEDIA PANEL -->
                        <Grid x:Name="PanelMusic" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Art with Soft Glow -->
                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1">
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                            </Border>

                            <!-- Track Info & Controls -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="TrackTitle" Text="Starboy" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Text="The Weeknd • Starboy" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />

                                <!-- Live Interactive Seek Bar with Elapsed & Remaining Time -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeElapsed" Grid.Column="0" Text="01:06" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center" />
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="35" Margin="5,0" Cursor="Hand" ValueChanged="SeekSlider_ValueChanged" />
                                    <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="-06:36" Foreground="{StaticResource TextSecondary}" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Playback Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="⏮" Width="36" Height="30" Click="PrevBtn_Click" Margin="5,0" />
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource ActionBtnStyle}" Content="⏸" Width="42" Height="32" FontSize="14" Background="{StaticResource AccentCyan}" Foreground="#000000" Click="PlayPauseBtn_Click" Margin="5,0" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="⏭" Width="36" Height="30" Click="NextBtn_Click" Margin="5,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 2. WEBSITES PANEL -->
                        <Grid x:Name="PanelWeb" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Add a site: any page, signed in, one click away." Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WebUrlInput" Grid.Column="0" Background="{StaticResource SurfaceDark}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" Padding="8,5" FontSize="12" Text="https://music.youtube.com" />
                                    <Button Grid.Column="1" Style="{StaticResource ActionBtnStyle}" Content="Open URL" Margin="6,0,0,0" Click="WebLaunchCustom_Click" />
                                </Grid>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://music.youtube.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="▶" Foreground="#FF0000" FontSize="17" HorizontalAlignment="Center" />
                                        <TextBlock Text="YT Music" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://www.youtube.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="YT" Foreground="#FF4444" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="YouTube" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://open.spotify.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="≋" Foreground="#1ED760" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Spotify" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://chatgpt.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="17" HorizontalAlignment="Center" />
                                        <TextBlock Text="ChatGPT" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- 3. NOTIFICATIONS PANEL -->
                        <Grid x:Name="PanelNotifications" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="NotificationsStack" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🔔" FontSize="26" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Nothing yet" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="When apps ping you, they'll land here until you dismiss them" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear All" HorizontalAlignment="Right" Click="NotificationsClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 4. SHELF PANEL -->
                        <Grid x:Name="PanelShelf" Visibility="Collapsed" AllowDrop="True" Drop="Shelf_Drop" DragOver="Shelf_DragOver">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="8" Padding="12,14" Margin="0,0,0,6" Background="{StaticResource GlassFill}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="📂 Drop files here" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock Text="They wait here until you need them" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl x:Name="ShelfItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="7" Padding="9,5" Margin="0,2.5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource ActionBtnStyle}" Content="Open" Padding="6,2" Margin="3,0" Click="ShelfItemOpen_Click" Tag="{Binding}" />
                                                            <Button Style="{StaticResource ActionBtnStyle}" Content="✕" Padding="6,2" Click="ShelfItemRemove_Click" Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <TextBlock x:Name="ShelfStatus" Text="Shelf holds 0 files" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear Shelf" HorizontalAlignment="Right" Click="ShelfClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 5. CLIPBOARD PANEL -->
                        <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="30" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Style="{StaticResource ActionBtnStyle}" Content="All" Margin="0,0,4,0" Background="{StaticResource GlassHover}" Foreground="{StaticResource AccentCyan}" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Images" Margin="0,0,4,0" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Snippets" Margin="0,0,4,0" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ClipboardItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="7" Padding="9,6" Margin="0,2.5" Cursor="Hand" MouseLeftButtonDown="ClipboardItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="{StaticResource TextPrimary}" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxHeight="30" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding FormattedTime}" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <Button Style="{StaticResource ActionBtnStyle}" Content="✕" Padding="5,2" Click="ClipboardDelete_Click" Tag="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <TextBlock Text="Click any snippet to copy back" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear History" HorizontalAlignment="Right" Click="ClipboardClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 6. WIDGETS BENTO PANEL -->
                        <Grid x:Name="PanelWidgets" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Clock Widget -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="10" Margin="3" Padding="12,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="WidgetClock" Text="14:32:05" Foreground="{StaticResource AccentCyan}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock x:Name="WidgetDate" Text="Friday, November 14, 2026" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Weather Widget -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="10" Margin="3" Padding="12,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="☀️ 22°C Sunny" Foreground="{StaticResource StatusOrange}" FontSize="17" FontWeight="Bold" />
                                    <TextBlock Text="Air Quality: Good • H:24° L:16°" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Hardware Stats -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="10" Margin="3" Padding="12,6">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="WidgetCpu" Text="CPU: 14%" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WidgetRam" Text="RAM: 7.6 / 16 GB" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="WidgetBattery" Text="98% ⚡" Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="Bold" />
                                        <TextBlock Text="AC Online" Foreground="{StaticResource TextSecondary}" FontSize="10.5" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Focus Timer / Pomodoro -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="10" Margin="3" Padding="12,6">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StopwatchDisplay" Grid.Column="0" Text="25:00" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="TimerToggleBtn" Style="{StaticResource ActionBtnStyle}" Content="▶" Padding="8,3" Margin="2,0" Click="TimerToggle_Click" />
                                        <Button Style="{StaticResource ActionBtnStyle}" Content="↺" Padding="8,3" Click="TimerReset_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 7. CONTROLS PANEL -->
                        <Grid x:Name="PanelControls" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="8,0">
                                <!-- Volume Slider -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Cursor="Hand" ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="50%" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Button x:Name="MuteBtn" Grid.Column="3" Style="{StaticResource ActionBtnStyle}" Content="Mute" Click="MuteBtn_Click" />
                                </Grid>

                                <!-- Brightness Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brightness" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" Cursor="Hand" ValueChanged="BrightnessSlider_ValueChanged" />
                                    <TextBlock x:Name="BrightnessLabel" Grid.Column="2" Text="70%" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Grid.Column="3" Width="0" />
                                </Grid>

                                <!-- Quick System Settings -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="📶 Wi-Fi" Margin="4,0" Click="WifiBtn_Click" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🔵 Bluetooth" Margin="4,0" Click="BluetoothBtn_Click" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🌙 Night Light" Margin="4,0" Click="NightLightBtn_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 8. TOOLS PANEL -->
                        <Grid x:Name="PanelTools" Visibility="Collapsed">
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource WebTileStyle}" Width="92" Height="72" Click="ScreenshotBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="Screenshot" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="92" Height="72" Click="SnipBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✂" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="Snip Tool" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="92" Height="72" Click="ColorPickerBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="Color Picker" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="92" Height="72" Click="TaskManagerBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="19" HorizontalAlignment="Center" />
                                        <TextBlock Text="Task Manager" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- 9. DECK PANEL -->
                        <Grid x:Name="PanelDeck" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="100" Height="100" Background="#FFFFFF" CornerRadius="8" Padding="5">
                                <Image x:Name="DeckQrCode" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="Your phone, as a deck for this PC" Foreground="{StaticResource AccentCyan}" FontSize="14.5" FontWeight="Bold" />
                                <TextBlock Text="Control media, volume, and hotkeys from your mobile browser on the same Wi-Fi network." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="Open Browser" Click="DeckOpenBrowser_Click" Margin="0,0,8,0" />
                                    <TextBlock Text="http://localhost:8088" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 10. CALLS PANEL -->
                        <Grid x:Name="PanelCalls" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="MicMuteCallBtn" Style="{StaticResource ActionBtnStyle}" Padding="18,10" Click="MicMuteCallBtn_Click" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MicMuteIcon" Text="🎤" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MicMuteStatus" Text="Mic on • Click to mute" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Audio Endpoint: Default System Sound" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Center" />
                                <TextBlock Text="Teams / Zoom / Discord GSMTC Sync: Connected" Foreground="{StaticResource StatusGreen}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 11. CHAT PANEL -->
                        <Grid x:Name="PanelChat" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="💬 AI Assistant Chat" Foreground="{StaticResource AccentCyan}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Ask questions, generate text, or control Windows with voice &amp; text." Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🤖 ChatGPT" Margin="4,0" Click="WebTile_Click" Tag="https://chatgpt.com" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🧠 Claude" Margin="4,0" Click="WebTile_Click" Tag="https://claude.ai" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 12. AGENTS PANEL -->
                        <Grid x:Name="PanelAgents" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="🤖 Autonomous Desktop Agents" Foreground="{StaticResource AccentCyan}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Antigravity Agent Runtime: Active" Foreground="{StaticResource StatusGreen}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <Border Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource HairlineBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                    <TextBlock Text="Running: Background System Telemetry &amp; GSMTC Media Sync" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 13. TILES PANEL -->
                        <Grid x:Name="PanelTiles" Visibility="Collapsed">
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource WebTileStyle}" Click="WifiBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📶" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Wi-Fi" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="BluetoothBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔵" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Bluetooth" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="NightLightBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🌙" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Night Light" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="MuteBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔇" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Mute Audio" Foreground="{StaticResource TextPrimary}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
