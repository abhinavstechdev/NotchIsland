<Window x:Class="NotchIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchIsland"
        Width="620" Height="340"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, sans-serif"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Tab Nav Button Style with Smooth Hover -->
        <Style x:Key="TabNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#70FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="#00F2FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style with Press Feedback -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2CFFFFFF" />
                                <Setter Property="Foreground" Value="#00F2FE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Launch Tile Style -->
        <Style x:Key="WebTileStyle" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#00F2FE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" HorizontalAlignment="Center" VerticalAlignment="Top">

        <!-- ================= UNIFIED MORPHING ISLAND CONTAINER ================= -->
        <Border x:Name="IslandContainer"
                Width="320" Height="40"
                Background="#070709"
                BorderBrush="#2AFFFFFF"
                BorderThickness="1"
                CornerRadius="20"
                Margin="0,6,0,0"
                ClipToBounds="True"
                Cursor="Hand"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonDown="Island_MouseLeftButtonDown">

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.75" />
            </Border.Effect>

            <Grid>
                <!-- ================= COMPACT PILL CONTENT ================= -->
                <Grid x:Name="PillContent" Margin="14,0" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Pet + Mini Equalizer -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PillPet" Text="(=^･ω･^=)" Foreground="#00F2FE" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="Bar1" Width="2.5" Height="10" Fill="#00F2FE" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar2" Width="2.5" Height="14" Fill="#4FACFE" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar3" Width="2.5" Height="8" Fill="#00F2FE" Margin="1,0" RadiusX="1" RadiusY="1" />
                            <Rectangle x:Name="Bar4" Width="2.5" Height="16" Fill="#4FACFE" Margin="1,0" RadiusX="1" RadiusY="1" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Track Info or Clock -->
                    <TextBlock x:Name="PillTitle"
                               Grid.Column="1"
                               Text="NotchIsland • 14:32"
                               Foreground="#FFFFFF"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Right: Battery & Status Dot -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PillBattery" Text="98% ⚡" Foreground="#34C759" FontSize="11" FontWeight="Bold" Margin="0,0,5,0" />
                        <Ellipse Width="6" Height="6" Fill="#34C759" />
                    </StackPanel>
                </Grid>

                <!-- ================= EXPANDED CARD CONTENT ================= -->
                <Grid x:Name="CardContent" Opacity="0" IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Navigation Bar -->
                    <Border Grid.Row="0" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 10 Feature Tabs -->
                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎵" ToolTip="Music &amp; Media" Click="Tab_Click" Tag="Music" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📁" ToolTip="File Shelf" Click="Tab_Click" Tag="Shelf" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📋" ToolTip="Clipboard History" Click="Tab_Click" Tag="Clipboard" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🧩" ToolTip="Widgets &amp; Clocks" Click="Tab_Click" Tag="Widgets" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎛" ToolTip="Controls &amp; Volume" Click="Tab_Click" Tag="Controls" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🌐" ToolTip="Web Quick Launch" Click="Tab_Click" Tag="Web" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🔔" ToolTip="Notifications" Click="Tab_Click" Tag="Notifications" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="✂" ToolTip="Tools &amp; Screenshots" Click="Tab_Click" Tag="Tools" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="📱" ToolTip="PC Deck" Click="Tab_Click" Tag="Deck" />
                                    <Button Style="{StaticResource TabNavButtonStyle}" Content="🎧" ToolTip="Calls &amp; Audio" Click="Tab_Click" Tag="Calls" />
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Settings & Collapse Icons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource TabNavButtonStyle}" Content="⚙" ToolTip="Settings" Click="SettingsBtn_Click" />
                                <Button Style="{StaticResource TabNavButtonStyle}" Content="▲" ToolTip="Collapse to Pill" Click="CollapseBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Dynamic Panels Area -->
                    <Grid Grid.Row="1" Margin="16,12">

                        <!-- 1. MUSIC PANEL -->
                        <Grid x:Name="PanelMusic" Visibility="Visible">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PanelMusicTranslate" Y="0" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Album Art with Soft Glow -->
                            <Border Grid.Column="0" Width="105" Height="105" CornerRadius="12" Background="#16161A" BorderBrush="#25FFFFFF" BorderThickness="1">
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                            </Border>

                            <!-- Track Info & Controls -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="TrackTitle" Text="Starboy" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" Text="The Weeknd • Starboy" Foreground="#88FFFFFF" FontSize="12.5" Margin="0,3,0,10" TextTrimming="CharacterEllipsis" />

                                <!-- Live Interactive Seek Bar -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TimeElapsed" Grid.Column="0" Text="01:23" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" />
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="35" Margin="6,0" Cursor="Hand" ValueChanged="SeekSlider_ValueChanged" />
                                    <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="03:50" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Playback Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="⏮" Width="38" Height="32" Click="PrevBtn_Click" Margin="6,0" />
                                    <Button x:Name="PlayPauseBtn" Style="{StaticResource ActionBtnStyle}" Content="⏸" Width="44" Height="36" FontSize="15" Background="#00F2FE" Foreground="#000000" Click="PlayPauseBtn_Click" Margin="6,0" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="⏭" Width="38" Height="32" Click="NextBtn_Click" Margin="6,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 2. SHELF PANEL -->
                        <Grid x:Name="PanelShelf" Visibility="Collapsed" AllowDrop="True" Drop="Shelf_Drop" DragOver="Shelf_DragOver">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,8" Background="#0EFFFFFF">
                                        <TextBlock Text="📂 Drag &amp; Drop files here to shelf, hold, or share" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center" />
                                    </Border>
                                    <ItemsControl x:Name="ShelfItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding FileSizeFormatted}" Foreground="#70FFFFFF" FontSize="11" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Style="{StaticResource ActionBtnStyle}" Content="Open" Padding="8,3" Margin="4,0" Click="ShelfItemOpen_Click" Tag="{Binding}" />
                                                            <Button Style="{StaticResource ActionBtnStyle}" Content="✕" Padding="8,3" Click="ShelfItemRemove_Click" Tag="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock x:Name="ShelfStatus" Text="Shelf holds 0 files" Foreground="#70FFFFFF" FontSize="11.5" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear All" HorizontalAlignment="Right" Click="ShelfClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 3. CLIPBOARD PANEL -->
                        <Grid x:Name="PanelClipboard" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ClipboardItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,3" Cursor="Hand" MouseLeftButtonDown="ClipboardItem_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Text}" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="32" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding FormattedTime}" Foreground="#60FFFFFF" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Style="{StaticResource ActionBtnStyle}" Content="✕" Padding="6,2" Click="ClipboardDelete_Click" Tag="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="Click any item to copy back to clipboard" Foreground="#70FFFFFF" FontSize="11.5" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear History" HorizontalAlignment="Right" Click="ClipboardClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 4. WIDGETS PANEL -->
                        <Grid x:Name="PanelWidgets" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Clock Widget -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Margin="4" Padding="14,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="WidgetClock" Text="14:32:05" Foreground="#00F2FE" FontSize="19" FontWeight="Bold" />
                                    <TextBlock x:Name="WidgetDate" Text="Friday, November 14, 2026" Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Weather Widget -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Margin="4" Padding="14,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="☀️ 24°C Sunny" Foreground="#FFCC00" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Air Quality: Good • H:26° L:18°" Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Hardware Stats -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Margin="4" Padding="14,8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="WidgetCpu" Text="CPU: 14%" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WidgetRam" Text="RAM: 7.6 / 16 GB" Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="WidgetBattery" Text="98% ⚡" Foreground="#34C759" FontSize="12.5" FontWeight="Bold" />
                                        <TextBlock Text="AC Connected" Foreground="#88FFFFFF" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Stopwatch / Timer -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Margin="4" Padding="14,8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StopwatchDisplay" Grid.Column="0" Text="00:00.0" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="TimerToggleBtn" Style="{StaticResource ActionBtnStyle}" Content="▶" Padding="10,4" Margin="3,0" Click="TimerToggle_Click" />
                                        <Button Style="{StaticResource ActionBtnStyle}" Content="↺" Padding="10,4" Click="TimerReset_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 5. CONTROLS PANEL -->
                        <Grid x:Name="PanelControls" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" Margin="10,0">
                                <!-- Volume Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Volume" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="50" Cursor="Hand" ValueChanged="VolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="50%" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Button x:Name="MuteBtn" Grid.Column="3" Style="{StaticResource ActionBtnStyle}" Content="Mute" Click="MuteBtn_Click" />
                                </Grid>

                                <!-- Brightness Slider -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brightness" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="70" Cursor="Hand" ValueChanged="BrightnessSlider_ValueChanged" />
                                    <TextBlock x:Name="BrightnessLabel" Grid.Column="2" Text="70%" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Grid.Column="3" Width="0" />
                                </Grid>

                                <!-- Quick System Settings -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="📶 Wi-Fi Settings" Margin="6,0" Click="WifiBtn_Click" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🔵 Bluetooth" Margin="6,0" Click="BluetoothBtn_Click" />
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="🌙 Night Light" Margin="6,0" Click="NightLightBtn_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 6. WEB PANEL -->
                        <Grid x:Name="PanelWeb" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WebUrlInput" Grid.Column="0" Background="#141418" Foreground="#FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="10,6" FontSize="12.5" Text="https://github.com/abhinavstechdev/NotchIsland" />
                                <Button Grid.Column="1" Style="{StaticResource ActionBtnStyle}" Content="Open URL" Margin="8,0,0,0" Click="WebLaunchCustom_Click" />
                            </Grid>

                            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://www.google.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Google" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://www.youtube.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="▶" Foreground="#FF3B30" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="YouTube" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://github.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🐙" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="GitHub" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://chatgpt.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="ChatGPT" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Click="WebTile_Click" Tag="https://reddit.com">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💬" Foreground="#FF4500" FontSize="18" HorizontalAlignment="Center" />
                                        <TextBlock Text="Reddit" Foreground="#FFFFFF" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- 7. NOTIFICATIONS PANEL -->
                        <Grid x:Name="PanelNotifications" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="NotificationsStack">
                                    <Border Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,3">
                                        <StackPanel>
                                            <TextBlock Text="NotchIsland • Ready" Foreground="#00F2FE" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="NotchIsland is active and monitoring media, clipboard, and hardware." Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#121215" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,3">
                                        <StackPanel>
                                            <TextBlock Text="System • Hardware Status" Foreground="#34C759" FontSize="11" FontWeight="Bold" />
                                            <TextBlock Text="Battery charging, CPU &amp; RAM optimal." Foreground="#FFFFFF" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="Windows notification center mirroring" Foreground="#70FFFFFF" FontSize="11.5" VerticalAlignment="Center" />
                                <Button Style="{StaticResource ActionBtnStyle}" Content="Clear All" HorizontalAlignment="Right" Click="NotificationsClear_Click" />
                            </Grid>
                        </Grid>

                        <!-- 8. TOOLS PANEL -->
                        <Grid x:Name="PanelTools" Visibility="Collapsed">
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource WebTileStyle}" Width="96" Height="76" Click="ScreenshotBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📸" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="Screenshot" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="96" Height="76" Click="SnipBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="✂" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="Snip Tool" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="96" Height="76" Click="ColorPickerBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="Color Picker" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource WebTileStyle}" Width="96" Height="76" Click="TaskManagerBtn_Click">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="Task Manager" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>

                        <!-- 9. DECK PANEL -->
                        <Grid x:Name="PanelDeck" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="105" Height="105" Background="#FFFFFF" CornerRadius="10" Padding="6">
                                <Image x:Name="DeckQrCode" Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="PC Deck Server Active" Foreground="#00F2FE" FontSize="15" FontWeight="Bold" />
                                <TextBlock Text="Control media, volume, and hotkeys from your smartphone or tablet on the same Wi-Fi network." Foreground="#88FFFFFF" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ActionBtnStyle}" Content="Open in Browser" Click="DeckOpenBrowser_Click" Margin="0,0,10,0" />
                                    <TextBlock Text="http://localhost:8088" Foreground="#60FFFFFF" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 10. CALLS PANEL -->
                        <Grid x:Name="PanelCalls" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="MicMuteCallBtn" Style="{StaticResource ActionBtnStyle}" Padding="20,12" Click="MicMuteCallBtn_Click" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MicMuteIcon" Text="🎤" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="MicMuteStatus" Text="Microphone LIVE (Click to Mute)" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Active Audio Stream: Default System Endpoint" Foreground="#70FFFFFF" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Text="Teams / Zoom / Discord GSMTC Sync: Connected" Foreground="#34C759" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</Window>
