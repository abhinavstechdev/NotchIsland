<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyTitle>NotchIsland</AssemblyTitle>
    <Product>NotchIsland - Native Windows Dynamic Island</Product>
    <Version>0.4.0</Version>
    <Authors>abhinavstechdev</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>libs\Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>libs\WinRT.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>libs\SkiaSharp.dll</HintPath>
    </Reference>
    <Reference Include="QRCoder">
      <HintPath>libs\QRCoder.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="libs\libSkiaSharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\deck\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\fonts\*.ttf" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>

</Project>
