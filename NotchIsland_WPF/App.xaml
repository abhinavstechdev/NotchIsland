<Application x:Class="NotchIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="GeistFont">pack://application:,,,/Assets/fonts/#Geist</FontFamily>
        <FontFamily x:Key="GeistMonoFont">pack://application:,,,/Assets/fonts/#Geist Mono</FontFamily>

        <SolidColorBrush x:Key="AccentBrush" Color="#5ee9ff" />
        <SolidColorBrush x:Key="BgBlackBrush" Color="#000000" />
        <SolidColorBrush x:Key="LineBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="GlassBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="GlassHiBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="DimBrush" Color="#8EF4F4F5" />
        <SolidColorBrush x:Key="FaintBrush" Color="#50F4F4F5" />
        <SolidColorBrush x:Key="WarmBrush" Color="#f5b84b" />
        <SolidColorBrush x:Key="OkBrush" Color="#4be08a" />
        <SolidColorBrush x:Key="HotBrush" Color="#ff5d5d" />
    </Application.Resources>
</Application>
