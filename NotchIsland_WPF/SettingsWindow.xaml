<Window x:Class="NotchIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NotchIsland Settings"
        Width="840" Height="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarBtnStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#A0FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF" />
                                <Setter Property="Foreground" Value="#00F2FE" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Setting Card Style -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#121215" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Border Background="#0C0C0E" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="NotchIsland" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" />
                    <Border Background="#2000F2FE" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                        <TextBlock Text="v0.5.0" Foreground="#00F2FE" FontSize="11" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Close Button -->
                <Button Click="CloseBtn_Click" HorizontalAlignment="Right" Margin="0,0,16,0"
                        Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                                <TextBlock Text="✕" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#30FF453A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" Padding="14,10">
                    <StackPanel>
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="⚙  General" IsChecked="True" Checked="Nav_Checked" Tag="General" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="🎨  Appearance" Checked="Nav_Checked" Tag="Appearance" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="🎵  Media &amp; Music" Checked="Nav_Checked" Tag="Media" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="📁  Shelf &amp; Clipboard" Checked="Nav_Checked" Tag="Shelf" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="🧩  Widgets" Checked="Nav_Checked" Tag="Widgets" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="🎛  Controls &amp; HUDs" Checked="Nav_Checked" Tag="Controls" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="⌨  Hotkeys" Checked="Nav_Checked" Tag="Hotkeys" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="📱  PC Deck" Checked="Nav_Checked" Tag="Deck" />
                        <RadioButton Style="{StaticResource SidebarBtnStyle}" Content="ℹ  About" Checked="Nav_Checked" Tag="About" />
                    </StackPanel>
                </Border>

                <!-- Right View Panel -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,14">
                    <StackPanel x:Name="ContentStack">
                        <!-- Dynamic Section will be populated here in code-behind -->
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
